# The C++ modules, built when LIBWINUI_BUILD_MODULES is on (the default where they work):
#
#   winui::winui    `import winui;`
#   winui::testing  `import winui.testing;`, re-exports winui
#
# Both are made from the public headers. modules/winui.cppm includes them in the module's purview
# and LIBWINUI_EXPORT exports every public declaration. That attaches the declarations to the
# module, so the library's sources have to be compiled once more as units of it, and
# cmake/ModuleUnit.cmake writes a wrapper for each of them. The result is a library of its own next
# to winui::headers and a program picks one of the two. An `import winui;` next to an #include of
# a libwinui header doesn't work.
#
# winui.testing exports its declarations from an extern "C++" block, which attaches them to the
# global module. Its sources are still units of winui, because they derive from the backend's
# private classes and those belong to winui.
#
# The standard library comes from `import std;` (LIBWINUI_MODULE_IMPORT_STD) or from the standard
# headers in front of the module declaration. Keep in mind, that with `import std;` MSVC defines a
# few constants (std::strong_ordering::less, ...) only in the std module's object file, and CMake
# 4.4 links that only into a target that has CXX_MODULE_STD set itself. Every target linking
# winui::winui needs the property then. AUTO turns `import std;` on only where CMake provides it
# for C++23 and libwinui is the top-level project, because then we set the property on our own
# targets. A consumer gets the standard headers, unless they ask for `import std;`.
#
# modules/*.cppm are generated by tools/api_surface.cpp (the api-surface target), and api-check
# fails when they're stale. A target that imports a module needs the module scan. The top-level
# CMakeLists.txt turns it off for everything else, so the targets here turn it back on. A consumer
# with a minimum of 3.28 or newer has it on by default.

set(LIBWINUI_MODULE_IMPORT_STD AUTO CACHE STRING "import std inside the modules: AUTO, ON or OFF")
set_property(CACHE LIBWINUI_MODULE_IMPORT_STD PROPERTY STRINGS AUTO ON OFF)
if(LIBWINUI_MODULE_IMPORT_STD STREQUAL "AUTO")
    if("23" IN_LIST CMAKE_CXX_COMPILER_IMPORT_STD AND LIBWINUI_STANDALONE)
        set(winui_import_std ON)
    else()
        set(winui_import_std OFF)
    endif()
elseif(LIBWINUI_MODULE_IMPORT_STD AND NOT "23" IN_LIST CMAKE_CXX_COMPILER_IMPORT_STD)
    message(FATAL_ERROR "LIBWINUI_MODULE_IMPORT_STD is ON, but CMake ${CMAKE_VERSION} provides no import std for C++23 here: ${CMAKE_CXX_COMPILER_IMPORT_STD_ERROR_MESSAGE}")
else()
    set(winui_import_std ${LIBWINUI_MODULE_IMPORT_STD})
endif()
message(STATUS "libwinui: modules winui and winui.testing, import std: ${winui_import_std}")

# Adds a module unit wrapper for each of <sources> to <target>. The depfile regenerates a wrapper
# when its source or any libwinui header the source reaches changes.
function(winui_add_module_units target testing)
    foreach(source IN LISTS ARGN)
        get_filename_component(absolute ${source} ABSOLUTE BASE_DIR ${PROJECT_SOURCE_DIR})
        file(RELATIVE_PATH relative ${PROJECT_SOURCE_DIR}/src ${absolute})
        set(unit ${CMAKE_CURRENT_BINARY_DIR}/module_units/${relative})
        add_custom_command(
            OUTPUT ${unit}
            COMMAND ${CMAKE_COMMAND} -DSOURCE=${absolute} -DOUTPUT=${unit} -DDEPFILE=${unit}.d
                    -DSRC_DIR=${PROJECT_SOURCE_DIR}/src -DINCLUDE_DIR=${PROJECT_SOURCE_DIR}/include
                    -DTESTING=${testing} -P ${PROJECT_SOURCE_DIR}/cmake/ModuleUnit.cmake
            DEPENDS ${absolute} ${PROJECT_SOURCE_DIR}/cmake/ModuleUnit.cmake
            DEPFILE ${unit}.d
            COMMENT "Module unit for ${relative}"
            VERBATIM)
        target_sources(${target} PRIVATE ${unit})
    endforeach()
endfunction()

function(winui_add_module target export_name file)
    add_library(${target} STATIC)
    add_library(winui::${export_name} ALIAS ${target})
    target_sources(${target}
        PUBLIC
            FILE_SET CXX_MODULES
            BASE_DIRS ${PROJECT_SOURCE_DIR}/modules
            FILES ${PROJECT_SOURCE_DIR}/modules/${file})
    winui_configure_target(${target} NO_SPEEDUPS)
    # The sources include each other's private headers by relative path from their own folder
    target_include_directories(${target} PRIVATE ${PROJECT_SOURCE_DIR}/src)
    target_compile_definitions(${target} PRIVATE LIBWINUI_IMPORT_STD=$<BOOL:${winui_import_std}>)
    set_target_properties(${target} PROPERTIES
        EXPORT_NAME ${export_name}
        OUTPUT_NAME ${target}
        DEBUG_POSTFIX d
        CXX_SCAN_FOR_MODULES ON
        CXX_MODULE_STD ${winui_import_std}
        POSITION_INDEPENDENT_CODE ON)
    # The wrapper already includes a source's system headers in front of the module declaration,
    # so the source's own include of them does nothing. A header without #pragma once (<commdlg.h>,
    # <imm.h>) still gets opened again, and MSVC and clang warn about an include in the purview.
    if(CMAKE_CXX_COMPILER_ID STREQUAL "MSVC")
        target_compile_options(${target} PRIVATE /wd5244)
    else()
        target_compile_options(${target} PRIVATE -Wno-include-angled-in-module-purview)
    endif()
    # CMake passes -TP to clang-cl next to the module flags, which leaves it unused, and that's an
    # error under /WX.
    if(MSVC AND CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
        target_compile_options(${target} PRIVATE -Wno-unused-command-line-argument)
    endif()
endfunction()

winui_add_module(winui_module winui winui.cppm)
winui_add_module_units(winui_module 0 ${LIBWINUI_SOURCES})

winui_add_module(winui_testing_module testing winui.testing.cppm)
winui_add_module_units(winui_testing_module 1 ${LIBWINUI_TESTING_SOURCES})
target_link_libraries(winui_testing_module PUBLIC winui_module)

# winui_import_module_targets(<dir>): the targets of <dir> import the module, so they need the
# module scan, and CXX_MODULE_STD when winui uses `import std;`. A target named *_headers is the
# header build of the same sources (examples/native_controls) and gets neither.
function(winui_import_module_targets dir)
    get_property(targets DIRECTORY ${dir} PROPERTY BUILDSYSTEM_TARGETS)
    foreach(target IN LISTS targets)
        get_target_property(type ${target} TYPE)
        if(type MATCHES "^(EXECUTABLE|STATIC_LIBRARY)$" AND NOT target MATCHES "_headers$")
            set_target_properties(${target} PROPERTIES
                CXX_SCAN_FOR_MODULES ON
                CXX_MODULE_STD ${winui_import_std})
        endif()
    endforeach()
endfunction()
