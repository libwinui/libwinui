# SPDX-License-Identifier: MIT
# cmake -P cmake/ModuleUnit.cmake: writes the wrapper that compiles one library source as a unit
# of the winui module (cmake/Modules.cmake runs it for every source, at build time).
#
#   -DSOURCE=<the .cpp>  -DOUTPUT=<the wrapper>  -DDEPFILE=<its depfile>
#   -DSRC_DIR=<src/>  -DINCLUDE_DIR=<include/>  -DTESTING=<0|1>
#
# The source keeps its includes. The wrapper puts the system headers it reaches (<windows.h>,
# <d2d1.h>, stb, ...) in the global module fragment, ahead of `module winui;`, so its own
# includes of them are no-ops after it. The standard library comes from import std, or, without
# it, from the standard headers in the same place. The C headers among them always go there too,
# since a module exports no macros (assert, SIZE_MAX, ...). Its standard includes are skipped
# through LIBWINUI_MODULE, the public headers through LIBWINUI_IMPORTED: the unit imports
# the module's interface instead.
#
# winui.testing exports the testing headers from an extern "C++" block, so they belong to the
# global module: a source that reaches one (a backend file that befriends WindowSeams, a testing
# source) gets it inside such a block first. A testing source defines those classes, so its own
# code goes inside one too; its private headers come before, outside: they belong to winui.
#
# A source that includes no libwinui header (the stb implementation) stays an ordinary
# translation unit.

set(winui_c_headers cassert cctype cerrno cfloat cinttypes climits cmath csignal cstdarg cstddef
                    cstdint cstdio cstdlib cstring ctime cwchar cwctype)

set(winui_seen "")
set(winui_std "")
set(winui_system "")
set(winui_private "")
set(winui_testing "")
set(winui_uses_winui FALSE)

# Collects what <file> includes, depth first in include order.
function(winui_scan file direct)
    file(STRINGS "${file}" lines REGEX "^[ \t]*#[ \t]*include[ \t]*[<\"][^>\"]+[>\"]")
    get_filename_component(dir "${file}" DIRECTORY)
    foreach(line IN LISTS lines)
        if(NOT line MATCHES "[<\"]([^>\"]+)([>\"])")
            continue()
        endif()
        set(name "${CMAKE_MATCH_1}")
        if(CMAKE_MATCH_2 STREQUAL ">")
            if(name MATCHES "^[a-z0-9_]+$")
                if(NOT name IN_LIST winui_std)
                    list(APPEND winui_std ${name})
                endif()
            elseif(NOT "<${name}>" IN_LIST winui_system)
                list(APPEND winui_system "<${name}>")
            endif()
            continue()
        endif()
        set(found "")
        foreach(base IN ITEMS "${dir}" "${SRC_DIR}" "${INCLUDE_DIR}")
            if(EXISTS "${base}/${name}")
                get_filename_component(found "${base}/${name}" ABSOLUTE)
                break()
            endif()
        endforeach()
        if(NOT found)
            if(NOT "\"${name}\"" IN_LIST winui_system)
                list(APPEND winui_system "\"${name}\"")
            endif()
            continue()
        endif()
        string(FIND "${found}" "${INCLUDE_DIR}/" public)
        string(FIND "${found}" "${INCLUDE_DIR}/winui/testing" testing_header)
        if(testing_header EQUAL 0)
            set(winui_uses_winui TRUE)
            if(NOT found IN_LIST winui_testing)
                list(APPEND winui_testing "${found}")
            endif()
        elseif(public EQUAL 0)
            set(winui_uses_winui TRUE)
        elseif(direct AND NOT found IN_LIST winui_private)
            list(APPEND winui_private "${found}")
        endif()
        if(NOT found IN_LIST winui_seen)
            list(APPEND winui_seen "${found}")
            set(winui_seen "${winui_seen}" PARENT_SCOPE)
            winui_scan("${found}" FALSE)
        endif()
    endforeach()
    foreach(var IN ITEMS winui_seen winui_std winui_system winui_private winui_testing winui_uses_winui)
        set(${var} "${${var}}" PARENT_SCOPE)
    endforeach()
endfunction()

get_filename_component(SRC_DIR "${SRC_DIR}" ABSOLUTE)
get_filename_component(INCLUDE_DIR "${INCLUDE_DIR}" ABSOLUTE)
winui_scan("${SOURCE}" TRUE)

set(text "// generated by cmake/ModuleUnit.cmake from ${SOURCE}; do not edit\n")
if(NOT winui_uses_winui)
    string(APPEND text "#include \"${SOURCE}\"\n")
else()
    string(APPEND text "module;\n#define LIBWINUI_MODULE\n#define LIBWINUI_IMPORTED\n")
    set(other_std "")
    foreach(name IN LISTS winui_std)
        if(name IN_LIST winui_c_headers)
            string(APPEND text "#include <${name}>\n")
        else()
            list(APPEND other_std ${name})
        endif()
    endforeach()
    if(other_std)
        string(APPEND text "#if !LIBWINUI_IMPORT_STD\n")
        foreach(name IN LISTS other_std)
            string(APPEND text "#include <${name}>\n")
        endforeach()
        string(APPEND text "#endif\n")
    endif()
    foreach(header IN LISTS winui_system)
        string(APPEND text "#include ${header}\n")
    endforeach()
    string(APPEND text "module winui;\n#if LIBWINUI_IMPORT_STD\nimport std;\n#endif\n")
    if(winui_testing)
        string(APPEND text "extern \"C++\"\n{\n")
        foreach(header IN LISTS winui_testing)
            string(APPEND text "#include \"${header}\"\n")
        endforeach()
        string(APPEND text "}\n")
    endif()
    if(TESTING)
        foreach(header IN LISTS winui_private)
            string(APPEND text "#include \"${header}\"\n")
        endforeach()
        string(APPEND text "extern \"C++\"\n{\n#include \"${SOURCE}\"\n}\n")
    else()
        string(APPEND text "#include \"${SOURCE}\"\n")
    endif()
endif()
file(WRITE "${OUTPUT}" "${text}")

# What the wrapper depends on, for the build tool: the source and every libwinui header it reaches.
set(deps "${SOURCE}" ${winui_seen})
list(TRANSFORM deps REPLACE " " "\\\\ ")
list(JOIN deps " \\\n  " deps)
string(REPLACE " " "\\ " target "${OUTPUT}")
file(WRITE "${DEPFILE}" "${target}: \\\n  ${deps}\n")
