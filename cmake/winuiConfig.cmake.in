# SPDX-License-Identifier: MIT
# find_package(winui CONFIG REQUIRED) gives winui::winui (`import winui;`) and winui::main when the
# package was built with the modules, and winui::headers and winui::headers_main (the same for
# #include <winui/winui.hpp>, plus the *_shared ones when the shared library was installed), each
# main target bringing its library and a plain int main(). COMPONENTS testing
# adds the opt-in testing tier: winui::testing, winui::testing_headers (and
# winui::testing_headers_shared).
@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
set(THREADS_PREFER_PTHREAD_FLAG ON)
find_dependency(Threads)

include(${CMAKE_CURRENT_LIST_DIR}/winuiTargets.cmake)

set(winui_testing_FOUND FALSE)
foreach(winui_component IN LISTS ${CMAKE_FIND_PACKAGE_NAME}_FIND_COMPONENTS)
    if(winui_component STREQUAL "testing")
        include(${CMAKE_CURRENT_LIST_DIR}/winuiTestingTargets.cmake)
        set(winui_testing_FOUND TRUE)
    else()
        set(winui_${winui_component}_FOUND FALSE)
    endif()
endforeach()
unset(winui_component)

check_required_components(winui)
